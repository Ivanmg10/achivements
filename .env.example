# Copy to .env.local and fill in. Never commit the filled-in file.

# ── Required ────────────────────────────────────────────────────────────────
# Public URL of this deployment. Password-reset links are built from it.
# Locally that is localhost; in production, https://www.cheevovault.com — the
# host visitors are actually on, since the apex redirects there. NextAuth,
# Steam's return_to and the reset links all have to agree with it.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DATABASE_URL=
# A database of its own for Preview (develop) and local work: a Neon branch of
# production. Wins over DATABASE_URL when set, never in production (VERCEL_ENV).
# On Vercel: Preview, all branches (any preview stays off production). Locally: here.
# Also set in Production (#178): db.js ignores it there; the PSN alerts cron reads
# pre's account pool through it, read-only, to send pre's alerts tagged [PRE].
PREVIEW_DATABASE_URL=


# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# PlayStation Network: a pool of service accounts (#178), added and renewed in
# the admin panel's PlayStation tab, stored sealed in psn_service_accounts.
# PSN_NPSSO only seeds the first account (PSN-1) of an empty pool; leave it
# empty once the pool has one. Never a daily-use account.
PSN_NPSSO=
# Seals the pool's NPSSOs and tokens (any long random string, e.g.
# `openssl rand -base64 48`). Set it once and never change it: what was sealed
# with it can no longer be opened. Unset, they are sealed from NEXTAUTH_SECRET
# as before. The same value in Production and Preview (pre is a copy of production).
PSN_SECRET_KEY=
# Telegram alerts about the pool (expiring sign-ins, quarantine, 429s, a daily
# digest), production only, one message per environment tagged [PRO] / [PRE].
# Reuse the owner's existing bot (Hermes) and their chat id: this app only ever
# calls sendMessage, never setWebhook/getUpdates/deleteWebhook. Unset, the
# expiring sign-ins are mailed to the admins instead (/api/cron/psnToken).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Lets the owner's agent read GET /api/ops/psn/status with
# `Authorization: Bearer <this>` (any long random string). Unset, the route is a 404.
PSN_STATUS_TOKEN=

# Xbox: the API key of ONE xbl.io (OpenXBL) account; every Xbox call is made as it.
# Server-only, never NEXT_PUBLIC_. Free plan: 150 calls an hour for the whole app.
# Unset, the admin Xbox explorer answers "not-configured".
OPENXBL_API_KEY=

# A Twitch app (dev.twitch.tv > Applications, category "Website Integration"),
# for IGDB: cover, backdrop and release year of PS3/Vita games, which Sony and
# the PlayStation Store have none of. Unset, those games keep their trophy icon.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Any long random string. Vercel Cron sends it to the /api/cron/* routes
# (cache sweep, scores, PSN alerts); unset, they refuse to run.
CRON_SECRET=

# ── Email (password recovery) ───────────────────────────────────────────────
# With only the key set, Resend sends from its shared address and delivers
# ONLY to the Resend account owner — fine for trying the flow, no use for
# anyone else. Set EMAIL_FROM to an address on a domain verified in Resend to
# reach everyone. Without the key, recovery answers "email-not-configured"
# and the UI says so. See README.md → Email.
RESEND_API_KEY=
# EMAIL_FROM=CheevoVault <no-reply@cheevovault.com>

# ── Privacy ─────────────────────────────────────────────────────────────────
# Shown on /privacy as the address for data requests. Required by the GDPR for
# a public site: set it before going live.
NEXT_PUBLIC_CONTACT_EMAIL=
# Google Analytics 4 (G-…). Unset means no analytics and no cookie banner.
# NEXT_PUBLIC_GA_ID=

# ── Optional ────────────────────────────────────────────────────────────────
# Closes sign-ups. Registration is open when this is unset.
# REGISTRATION_OPEN=false

# Optional: Google Search Console HTML-tag verification token (a DNS check needs nothing here).
# GOOGLE_SITE_VERIFICATION=
