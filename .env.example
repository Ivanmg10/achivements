# Copy to .env.local and fill in. Never commit the filled-in file.

# ── Required ────────────────────────────────────────────────────────────────
# Public URL of this deployment. Password-reset links are built from it.
# Locally that is localhost; in production, https://cheevovault.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DATABASE_URL=


# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ── Email (password recovery) ───────────────────────────────────────────────
# With only the key set, Resend sends from its shared address and delivers
# ONLY to the Resend account owner — fine for trying the flow, no use for
# anyone else. Set EMAIL_FROM to an address on a domain verified in Resend to
# reach everyone. Without the key, recovery answers "email-not-configured"
# and the UI says so. See README.md → Email.
RESEND_API_KEY=
# EMAIL_FROM=CheevoVault <no-reply@cheevovault.com>

# ── Optional ────────────────────────────────────────────────────────────────
# Closes sign-ups. Registration is open when this is unset.
# REGISTRATION_OPEN=false
