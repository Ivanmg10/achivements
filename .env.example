# Copy to .env.local and fill in. Never commit the filled-in file.

# ── Required ────────────────────────────────────────────────────────────────
# Public URL of this deployment. Password-reset links are built from it.
# Locally that is localhost; in production, https://www.cheevovault.com — the
# host visitors are actually on, since the apex redirects there. NextAuth,
# Steam's return_to and the reset links all have to agree with it.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
DATABASE_URL=


# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Any long random string. Vercel Cron sends it to /api/cron/sweepCache, the
# daily cleanup of expired Steam cache rows; unset, that route refuses to run.
CRON_SECRET=

# ── Email (password recovery) ───────────────────────────────────────────────
# With only the key set, Resend sends from its shared address and delivers
# ONLY to the Resend account owner — fine for trying the flow, no use for
# anyone else. Set EMAIL_FROM to an address on a domain verified in Resend to
# reach everyone. Without the key, recovery answers "email-not-configured"
# and the UI says so. See README.md → Email.
RESEND_API_KEY=
# EMAIL_FROM=CheevoVault <no-reply@cheevovault.com>

# ── Privacy ─────────────────────────────────────────────────────────────────
# Shown on /privacy as the address for data requests. Required by the GDPR for
# a public site: set it before going live.
NEXT_PUBLIC_CONTACT_EMAIL=
# Google Analytics 4 (G-…). Unset means no analytics and no cookie banner.
# NEXT_PUBLIC_GA_ID=

# ── Optional ────────────────────────────────────────────────────────────────
# Closes sign-ups. Registration is open when this is unset.
# REGISTRATION_OPEN=false
